          "is_default",
          "run_id",
          "created_at",
          "metrics"
        ],
        "title": "ModelSummary",
        "type": "object"
      },
      "OddsDay": {
        "description": "One league's odds pulls on one day.\n\n`pulls` and `bytes` come from listing alone. `latest_records` is the only\ntrue record count on the dashboard -- odds objects are small and immutable,\nso the newest one per league is cheap to open and count (section 12.4).",
        "properties": {
          "bytes": {
            "title": "Bytes",
            "type": "integer"
          },
          "day": {
            "format": "date",
            "title": "Day",
            "type": "string"
          },
          "latest_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest At"
          },
          "latest_records": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Records"
          },
          "league": {
            "title": "League",
            "type": "string"
          },
          "pulls": {
            "title": "Pulls",
            "type": "integer"
          }
        },
        "required": [
          "league",
          "day",
          "pulls",
          "bytes"
        ],
        "title": "OddsDay",
        "type": "object"
      },
      "PredictResponse": {
        "properties": {
