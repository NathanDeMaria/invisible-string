      "get": {
        "operationId": "get_games_api_games_get",
        "parameters": [
          {
            "description": "Days of finished games to include, counted in US Central time.",
            "in": "query",
            "name": "back",
            "required": false,
            "schema": {
              "default": 2,
              "description": "Days of finished games to include, counted in US Central time.",
              "maximum": 7,
              "minimum": 0,
              "title": "Back",
              "type": "integer"
            }
          },
          {
            "description": "Days of upcoming games beyond today. 0 is the rest of today.",
            "in": "query",
            "name": "ahead",
            "required": false,
            "schema": {
              "default": 1,
              "description": "Days of upcoming games beyond today. 0 is the rest of today.",
              "maximum": 7,
              "minimum": 0,
              "title": "Ahead",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GamesResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Games"
      }
    },
    "/api/games/{league}/{game_id}": {
      "get": {
        "description": "Everything this app knows about one game.\n\nThe same row `/api/games` builds, from the same window and the same\nrelease -- a game page that disagreed with the table it was reached from\nwould be worse than no game page. What it adds is the partition its plays\nlive in, and whether there's a model that could draw them.\n\n404 for a game outside the week either side of today (see\n`app.games.find_game`): the horizon is a cost cap, and a link that\noutlived it should say so rather than render an empty page.",
        "operationId": "get_game_api_games__league___game_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "league",
            "required": true,
            "schema": {
