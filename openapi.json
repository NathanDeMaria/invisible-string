            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stopped At"
          }
        },
        "required": [
          "job_id",
          "name",
          "definition",
          "status",
          "created_at",
          "duration_seconds"
        ],
        "title": "JobRun",
        "type": "object"
      },
