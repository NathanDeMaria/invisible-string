                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Leagues"
      }
    },
    "/api/leagues/{league}/ratings": {
      "get": {
        "operationId": "get_ratings_api_leagues__league__ratings_get",
        "parameters": [
          {
            "in": "path",
            "name": "league",
            "required": true,
            "schema": {
              "title": "League",
              "type": "string"
            }
          },
          {
            "description": "Defaults to the league's lowest-Brier model.",
            "in": "query",
            "name": "model",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Defaults to the league's lowest-Brier model.",
              "title": "Model"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RatingsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Ratings"
      }
    },
    "/api/predict": {
      "get": {
        "operationId": "predict_api_predict_get",
        "parameters": [
          {
            "description": "e.g. mens",
            "in": "query",
            "name": "league",
            "required": true,
            "schema": {
              "description": "e.g. mens",
              "title": "League",
              "type": "string"
            }
          },
          {
            "description": "Home team, exactly as the ratings name it.",
            "in": "query",
            "name": "home",
            "required": true,
            "schema": {
              "description": "Home team, exactly as the ratings name it.",
              "title": "Home",
              "type": "string"
            }
          },
          {
            "description": "Away team.",
            "in": "query",
            "name": "away",
            "required": true,
            "schema": {
              "description": "Away team.",
              "title": "Away",
              "type": "string"
            }
          },
          {
            "description": "Turns off home advantage.",
            "in": "query",
            "name": "neutral",
            "required": false,
            "schema": {
              "default": false,
              "description": "Turns off home advantage.",
              "title": "Neutral",
              "type": "boolean"
            }
          },
          {
            "description": "Defaults to the league's lowest-Brier model.",
            "in": "query",
            "name": "model",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Defaults to the league's lowest-Brier model.",
              "title": "Model"
            }
          },
          {
            "description": "What-if override for the model's home advantage.",
            "in": "query",
            "name": "home_advantage",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "What-if override for the model's home advantage.",
              "title": "Home Advantage"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Predict"
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
