          "duration_seconds": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Wall time in the container, not counting time spent RUNNABLE.\n\nQueue wait is a property of the queue rather than of the job, and\nfolding it in would make every job look slow whenever something big is\nahead of it.",
            "readOnly": true,
            "title": "Duration Seconds"
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exit Code"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "status_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status Reason"
          },
