{
  "components": {
    "schemas": {
      "CurvePoint": {
        "description": "One snap of the curve.\n\nEverything an axis label or a tooltip needs, so the page never goes back\nto the plays: `period` and `clock_seconds` are what a point is *called*\n(\"Q3 7:22\"), `seconds_remaining` is where it sits on the time axis, and\nthe two scores are what makes a step in the line legible.\n\n`home_win_prob` is named for `GamePrediction.home_win_prob` beside it,\nwhich is the same quantity asked before the game rather than during it.",
        "properties": {
          "away_score": {
            "title": "Away Score",
            "type": "integer"
          },
          "clock_seconds": {
            "title": "Clock Seconds",
            "type": "integer"
          },
          "home_score": {
            "title": "Home Score",
            "type": "integer"
          },
          "home_win_prob": {
            "title": "Home Win Prob",
            "type": "number"
          },
          "period": {
            "title": "Period",
            "type": "integer"
          },
          "play_id": {
            "title": "Play Id",
            "type": "string"
          },
          "play_number": {
            "title": "Play Number",
            "type": "integer"
          },
          "seconds_remaining": {
            "title": "Seconds Remaining",
            "type": "integer"
          }
        },
        "required": [
          "play_id",
          "play_number",
          "period",
          "clock_seconds",
          "seconds_remaining",
          "home_score",
          "away_score",
          "home_win_prob"
        ],
        "title": "CurvePoint",
        "type": "object"
      },
      "GameControl": {
        "description": "Share of the game each team spent winning it, weighted by the clock.\n\nNot a win probability: 0.68 doesn't say the home team was ever 68% to\nwin, it says that averaged over the minutes, that's where the model had\nthem. `seconds` is what the average covers -- regulation only, since\ncollege overtime has no clock to weight by -- and is on the wire so the\npage can say so rather than implying a full sixty minutes.",
        "properties": {
          "away": {
            "title": "Away",
            "type": "number"
          },
          "home": {
            "title": "Home",
            "type": "number"
          },
          "seconds": {
            "title": "Seconds",
            "type": "integer"
          }
        },
        "required": [
          "home",
          "away",
          "seconds"
        ],
        "title": "GameControl",
        "type": "object"
      },
      "GameDetail": {
        "description": "One game, with the two things only a page about *it* has room for.\n\n`season` and `week` aren't schedule facts -- they're where endgame filed\nthis game's play-by-play, and the season file is the only place that says\n(see `app.games.ScheduledGame`). They're on the wire because a reader\nlooking at one game may well want to know which week of which season it\nwas, and because they are what the curve below is fetched by.\n\n`has_win_probability` says whether a fit exists *for the league*, which is\nthe question the page has before it asks for a curve: only football has\none, and asking for a basketball game's would be a request that can only\n404. It does not promise a curve -- the game may have no play-by-play, and\nmost of an NCAAFB week doesn't.",
        "properties": {
          "away": {
            "title": "Away",
            "type": "string"
          },
          "away_score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Away Score"
          },
          "completed": {
            "title": "Completed",
            "type": "boolean"
          },
          "day": {
            "format": "date",
            "title": "Day",
            "type": "string"
          },
          "game_id": {
            "title": "Game Id",
            "type": "string"
          },
          "has_win_probability": {
            "title": "Has Win Probability",
            "type": "boolean"
          },
          "home": {
            "title": "Home",
            "type": "string"
          },
          "home_score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Home Score"
          },
          "league": {
            "title": "League",
            "type": "string"
          },
          "market_spread": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Market Spread"
          },
          "neutral": {
            "title": "Neutral",
            "type": "boolean"
          },
          "prediction": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GamePrediction"
              },
              {
                "type": "null"
              }
            ]
          },
          "season": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Season"
          },
          "start": {
            "format": "date-time",
            "title": "Start",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "week": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Week"
          }
        },
        "required": [
          "league",
          "game_id",
          "start",
          "day",
          "home",
          "away",
          "neutral",
          "completed",
          "status",
          "home_score",
          "away_score",
          "market_spread",
          "prediction",
          "season",
          "week",
          "has_win_probability"
        ],
        "title": "GameDetail",
        "type": "object"
      },
