            "title": "Rd"
          },
          "team": {
            "title": "Team",
            "type": "string"
          },
          "wins": {
            "title": "Wins",
            "type": "integer"
          }
        },
        "required": [
          "rank",
          "team",
          "rating",
          "rd",
          "wins",
          "losses"
        ],
        "title": "TeamRow",
        "type": "object"
      },
      "TrainedThrough": {
        "description": "Watermark for the incremental refresh job.\n\n`processed_game_ids` is a set of ids rather than a timestamp because games\nget re-fetched and scores corrected; ids are what make the refresh\nidempotent. Current season only -- it's a resume marker, not an audit log.",
        "properties": {
          "last_game_date": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Game Date"
          },
          "processed_game_ids": {
            "items": {
              "type": "string"
            },
            "title": "Processed Game Ids",
            "type": "array"
          },
          "season_year": {
            "title": "Season Year",
            "type": "integer"
          }
        },
        "required": [
          "season_year"
        ],
        "title": "TrainedThrough",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VolumeResponse": {
        "properties": {
          "odds": {
