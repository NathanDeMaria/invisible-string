  "info": {
    "title": "invisible-string",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/jobs": {
      "get": {
        "operationId": "get_jobs_api_jobs_get",
        "parameters": [
          {
            "description": "Days of history. Capped at 7 because AWS Batch keeps completed job records for about a week.",
            "in": "query",
            "name": "days",
            "required": false,
            "schema": {
              "default": 7,
              "description": "Days of history. Capped at 7 because AWS Batch keeps completed job records for about a week.",
              "maximum": 7,
              "minimum": 1,
              "title": "Days",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Jobs"
      }
    },
    "/api/jobs/volume": {
      "get": {
        "operationId": "get_volume_api_jobs_volume_get",
        "parameters": [
          {
            "description": "Days of history. Capped at 7 because AWS Batch keeps completed job records for about a week.",
            "in": "query",
            "name": "days",
            "required": false,
            "schema": {
              "default": 7,
              "description": "Days of history. Capped at 7 because AWS Batch keeps completed job records for about a week.",
              "maximum": 7,
              "minimum": 1,
              "title": "Days",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VolumeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Volume"
      }
    },
    "/api/leagues": {
      "get": {
        "operationId": "list_leagues_api_leagues_get",
