          "predicted_spread",
          "home_rating",
          "away_rating"
        ],
        "title": "PredictResponse",
        "type": "object"
      },
      "RatingsResponse": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "league": {
            "title": "League",
            "type": "string"
          },
          "metrics": {
            "$ref": "#/components/schemas/Metrics"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "ratings": {
            "items": {
              "$ref": "#/components/schemas/TeamRow"
            },
            "title": "Ratings",
            "type": "array"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "trained_through": {
            "$ref": "#/components/schemas/TrainedThrough"
          }
        },
        "required": [
          "league",
          "model",
          "run_id",
          "created_at",
          "trained_through",
          "metrics",
          "ratings"
        ],
        "title": "RatingsResponse",
        "type": "object"
      },
      "SeasonObject": {
        "description": "A season artifact: how big, how fresh, and how many games are in it.\n\nThe counts are only on the `.pkl` games artifact -- the possessions and\nbox-score CSVs beside it are rows, not games, and get `None` rather than a\nnumber that would read as one.\n\n`games` is everything in the file, including games that haven't been played\nyet: a season file carries the whole schedule. `games_today` and\n`games_in_window` count only *completed* games, because the question they\nanswer is \"did last night's results land\", and a fixture list can answer\nthat yes while the scrape brought back nothing (section 12.4).",
        "properties": {
          "artifact": {
            "title": "Artifact",
            "type": "string"
          },
          "bytes": {
            "title": "Bytes",
            "type": "integer"
          },
          "games": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Games"
          },
          "games_in_window": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Games In Window"
          },
          "games_today": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Games Today"
          },
          "key": {
            "title": "Key",
            "type": "string"
          },
          "last_modified": {
            "format": "date-time",
            "title": "Last Modified",
            "type": "string"
          },
          "league": {
            "title": "League",
            "type": "string"
          },
          "year": {
            "title": "Year",
            "type": "integer"
          }
        },
        "required": [
          "league",
          "year",
          "artifact",
          "key",
          "bytes",
          "last_modified"
        ],
        "title": "SeasonObject",
        "type": "object"
      },
      "TeamRow": {
        "properties": {
          "losses": {
            "title": "Losses",
            "type": "integer"
          },
          "rank": {
            "title": "Rank",
            "type": "integer"
          },
          "rating": {
            "title": "Rating",
            "type": "number"
          },
          "rd": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
